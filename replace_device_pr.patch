+async def test_flow_confirm_mentions_a_kept_serial_number(hass: HomeAssistant) -> None:
+    entry = _entry(hass, OLD_ADDRESS)
+    _populate(hass, entry, OLD_ADDRESS, OLD_SERIAL)
+    flow = _flow(hass, entry)
